{
   "Serilog":
  {
      "Using":["Serilog.Sinks.Console"],
      "MinimumLevel": 
      {
        "Default": "Information",
        "Override": 
        {
          "Microsoft":"Warning"
        }
      },
      "WriteTo":
      [
        {"Name":"Console"}
      ],
      "Enrich":
      [
        "FromLogContext", "WithMachineName", "WithThreadId"
      ]
  },
  "AllowedHosts": "mycourse-api.kindpond-8d349b8e.germanywestcentral.azurecontainerapps.io"


}
